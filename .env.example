# ── Core Configuration (Required) ────────────────────────────────────

# AWS Bedrock Mantle API key (REQUIRED)
BEDROCK_MANTLE_API_KEY=your_api_key_here

# AWS region where Bedrock is enabled
AWS_REGION=ap-south-1

# Port this proxy listens on
PORT=3000

# ── Optional Integrations ─────────────────────────────────────────────

# Telegram Bot Integration (optional)
# Set TELEGRAM_ENABLED=false to disable Telegram completely
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here
TELEGRAM_ENABLED=true

# Memory System Integration (optional)
# Set ENABLE_MEMORY_INTEGRATION=false to disable memory system
ENABLE_MEMORY_INTEGRATION=true

# PostgreSQL for Execution Traces (optional)
# Leave empty to disable trace persistence
DATABASE_URL="postgresql://your_username@localhost:5432/your_database_name"

# ── Advanced Configuration ───────────────────────────────────────────

# Override Bedrock Mantle endpoint (optional)
# ANTHROPIC_BEDROCK_MANTLE_BASE_URL=https://bedrock-mantle.{region}.api.aws

# ── Notes ────────────────────────────────────────────────────────────

# All integrations have graceful degradation:
# - If TELEGRAM_BOT_TOKEN is missing, Telegram will log a warning
# - If DATABASE_URL is missing, traces will not be persisted
# - If ENABLE_MEMORY_INTEGRATION=false, memory system won't start
# - If BEDROCK_MANTLE_API_KEY is missing, proxy will fail on requests

# Graphiti Memory Integration (optional)
ENABLE_MEMORY_INTEGRATION=false
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=test1234
