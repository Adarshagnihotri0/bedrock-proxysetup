graph TB
    subgraph Clients["AI Clients"]
        OSDK["OpenAI SDK"]
        CSP["Claude SDK"]
        LC["LangChain"]
        OH["OpenHands"]
        CDEV["Continue.dev"]
    end

    subgraph Proxy["Bedrock Proxy"]
        direction TB
        VALID["Request Validation"]
        AUTH["Authentication"]
        TRANS["Model Translation"]
        STREAM["Streaming Handler"]
        MEM["Memory Hooks<br/>(Optional)"]
        LOG["Structured Logging"]
        
        VALID --> AUTH
        AUTH --> TRANS
        TRANS --> STREAM
        STREAM --> MEM
        MEM --> LOG
    end

    subgraph Integrations["Optional Services"]
        PG[("PostgreSQL<br/>Trace Storage")]
        RD[("Redis<br/>Cache")]
        TG["Telegram<br/>Notifications"]
        GM["Graphiti<br/>Memory"]
    end

    subgraph AWS["AWS Bedrock"]
        BM["Bedrock Mantle API"]
        GLM["GLM Models"]
        CLD["Claude Models"]
    end

    Clients -->|/v1/chat/completions<br/>/v1/messages| VALID
    LOG -->|HTTP REST| BM
    
    BM --> GLM
    BM --> CLD
    
    MEM -.->|Optional| PG
    STREAM -.->|Optional| RD
    MEM -.->|Optional| TG
    MEM -.->|Optional| GM

    classDef client fill:#3b82f6,stroke:#1e40af,color:#fff
    classDef proxy fill:#2563eb,stroke:#1e40af,color:#fff
    classDef aws fill:#f59e0b,stroke:#d97706,color:#fff
    classDef optional fill:#94a3b8,stroke:#64748b,color:#fff,stroke-dasharray: 5 5
    
    class OSDK,CSP,LC,OH,CDEV client
    class VALID,AUTH,TRANS,STREAM,MEM,LOG proxy
    class BM,GLM,CLD aws
    class PG,RD,TG,GM optional
