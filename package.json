{
  "name": "bedrock-proxy",
  "version": "1.0.0",
  "description": "Anthropic-compatible proxy for AWS Bedrock — integrates with Claude Code",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "build:notify": "npm run build",
    "start": "node dist/index.js",
    "dev": "nodemon src/index.ts",
    "dev:notify": "npm run dev",
    "test": "jest",
    "test:watch": "jest --watch",
    "evaluate:retrieval": "ts-node scripts/evaluate-retrieval.ts",
    "evaluate:retrieval-v2": "ts-node scripts/evaluate-retrieval-v2.ts",
    "verify:audit": "ts-node scripts/verify-audit.ts",
    "test:canonical": "ts-node scratch/canonical-test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.758.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "ioredis": "^5.11.1",
    "neo4j-driver": "^6.2.0",
    "nodemon": "^3.1.14",
    "pg": "^8.22.0",
    "uuid": "^14.0.1",
    "winston": "^3.19.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/ioredis": "^4.28.10",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.20.0",
    "@types/pg-query-stream": "^1.0.3",
    "@types/uuid": "^10.0.0",
    "jest": "^30.4.2",
    "pg-query-stream": "^4.16.0",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  }
}
